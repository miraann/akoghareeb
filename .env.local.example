# Supabase project settings — Project Settings > API in the Supabase dashboard.
# Both are safe to expose to the browser (NEXT_PUBLIC_*); write access is
# enforced by Row Level Security + the `admins` table, not by keeping these
# secret. Never add the service_role key to this project — nothing here
# needs it, and it would bypass RLS entirely if it leaked to the client.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
